{:paths ["src" "resources"]

 ;; The private registry. Declared HERE, not only in a developer's user-level
 ;; deps.edn, so a cold clone and CI resolve hive-agi artifacts identically.
 ;; Credentials come from ~/.m2/settings.xml (server id "hive-gitea").
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}

 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  org.clojure/data.json {:mvn/version "2.5.2"}

  io.github.hive-agi/hive-carto-flow {:mvn/version "0.1.18"}
  ;; 0.1.11 carries the keyed panel repaint. The Vim runtime this addon
  ;; extracts IS this artifact's, so the pin decides what a user's Vim runs.
  io.github.hive-agi/hive-vessel {:mvn/version "0.1.11"}
  io.github.hive-agi/hive-addon {:mvn/version "1.0.14"}
  io.github.hive-agi/hive-events {:mvn/version "0.5.17"}
  io.github.hive-agi/hive-dsl {:mvn/version "0.5.31"}}

 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-m" "hive-carto-flow-vim.test-runner"]}

  :dev {:extra-paths ["test"]}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.22"}}
          :ns-default hive-build.api}}}
